<!doctype html>
<html id="index" class="no-js" data-bs-theme="light" lang="en">
	<head>
		<meta charset="utf-8">
		<base href="/">
		<meta name="viewport" content="width=device-width, initial-scale=1">

		<title>Erg Explorer Lite</title>

		<!-- Pages may load images and media from anywhere (NFTs), but scripts, styles and fonts only from here -->
		<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' http: https:; img-src * data: blob:; media-src * data: blob:; frame-src 'none'; object-src 'none'; base-uri 'self'">

		<!-- Favicon -->
		<link rel="icon" type="image/png" href="favicon.png">
		<link rel="apple-touch-icon" type="image/png" href="apple-touch-icon.png">

		<!-- Bootstrap 5 CSS -->
        <link href="vendor/bootstrap/bootstrap.min.css" rel="stylesheet">

        <!-- Additional theme file -->
        <link id="additionalTheme" href="" rel="stylesheet" media="(prefers-color-scheme: dark)">

		<!-- Font Awesome CSS -->
		<link rel="stylesheet" href="vendor/fontawesome/css/all.min.css">
		<link rel="stylesheet" href="styles/vars.css?v=2">

		<!-- build:css styles/main.css -->
		<link rel="stylesheet" href="styles/main.css?v=15">
		<!-- endbuild -->
		<link rel="stylesheet" href="styles/mew-ad.css?v=1">
		<link rel="stylesheet" href="styles/funding.css?v=2">
		<link rel="stylesheet" href="styles/lite.css?v=13">
		<link rel="preload" href="fonts/mew-ad-manrope.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="preload" href="fonts/mew-ad-satisfy.woff2" as="font" type="font/woff2" crossorigin>
				
		{% block styles %}{% endblock %}
			
		<script src="./scripts/common/config.js?v=44"></script>
		<script src="./scripts/common/params.js?v=41"></script>
		<script src="./scripts/common/node.js?v=1"></script>

        <script type="text/javascript">
        	var theme = 'dark';

        	function updateTheme() {   
				theme = localStorage.getItem('theme');

				if (theme == undefined) {
					theme = 'dark';
				}

				let bsTheme = theme == 'light' ? 'light' : 'dark';

				document.getElementById('index').setAttribute('data-bs-theme', bsTheme);
				document.getElementById('index').setAttribute('data-theme', theme);

				if (theme != 'light') {
                    document.getElementById('additionalTheme').setAttribute('href', 'vendor/bootstrap-dark/bootstrap-nightfall.min.css');
				} else {
					document.getElementById('additionalTheme').setAttribute('href', '');
				}
        	}

        	updateTheme();

        	function updateNav() {
				const themeSwitchers = document.getElementsByClassName('theme-switcher');

				if (theme === 'mew') {
				    Array.from(themeSwitchers).forEach((x) => {
				        x.innerHTML = '<img style="position:relative;top:-2px;height:18px;width:auto;" src="./images/logo-new-mew.png" />';
				    });

				    let eLogo = document.getElementById('erg-logo');
				    if (eLogo) {
				    	eLogo.src = "./images/logo-new-mew.png";
				    }
				} else {
				    Array.from(themeSwitchers).forEach((x) => {
				        x.innerHTML = '<i class="fas fa-moon"></i>';
				    });

				    let eLogo = document.getElementById('erg-logo');
				    if (eLogo) {
				    	eLogo.src = "./images/logo-new.png";
				    }
				}
        	}

        	function loadCustomColor() {
				if (params['mainColor'] != undefined) {
					if (params['mainColor'] == '') {
						localStorage.removeItem('main-color');
					} else {
						localStorage.setItem('main-color', params['mainColor']);
					}
				}

				if (params['mainColorHover'] != undefined) {
					if (params['mainColorHover'] == '') {
						localStorage.removeItem('main-color-hover');
					} else {
						localStorage.setItem('main-color-hover', params['mainColorHover']);
					}
				}

				let mainColor = localStorage.getItem('main-color');
				let mainColorHover = localStorage.getItem('main-color-hover');

				if (mainColor != undefined) {
					document.documentElement.style.setProperty('--main-color', mainColor);
				}

				if (mainColorHover != undefined) {
					document.documentElement.style.setProperty('--main-color-hover', mainColorHover);
				}
			}

			loadCustomColor();
        </script>

		<!-- SEO -->
		<meta name="description" content="Erg Explorer Lite: an Ergo blockchain explorer that reads everything from your own indexed node.">
		<meta name="keywords" content="ergo, erg, blockchain, explorer, tool, browser, transaction, block, token, nft, scan, wallet, search, address, explore">

		<meta property="og:title" content="Erg Explorer Lite" />
		<meta property="og:type" content="website" />
		<meta property="og:image" content="images/logo.png" />

	</head>

	<body >

		{% block navigation %}{% endblock %}

		<!-- Page Content -->
		<div class="container p-0">





			{% include "partials/testnet-notice.njk" %}

			{% include "partials/mew-ad.njk" %}

			{% include "partials/search-form.njk" %}

			{% block content %}{% endblock %}
		</div>

	<script type="text/javascript">
		updateNav();
	</script>
	
		<!-- Footer -->
		{% include "partials/footer.njk" %}

		{% include "partials/funding-popup.njk" %}

		<!-- Bootstrap toasts: one container, so toasts shown together stack instead of covering each other -->
		<div class="toast-container position-fixed bottom-0 end-0 p-3">
			<!-- Notification prompt -->
			<div id="notificationToast" data-bs-config='{"autohide":false}' class="toast" role="alert" aria-live="assertive" aria-atomic="true">
				<div id="notificationToastBody" class="toast-body d-flex align-items-end">
					<p id="notificationToastText">Transaction pending. Do you want to get notified when it confirms?</p>
					<br>
					<button class="btn btn-primary m-1 end-0" onclick="onNotificationToastNo()">No</button>
					<button class="btn btn-info m-1 end-0" onclick="onNotificationToastYes()">Yes</button>
				</div>
			</div>

			<!-- Custom toast (pending tx tracking) -->
			<div id="customToast" data-bs-config='{"autohide":false}' class="toast" role="alert" aria-live="assertive" aria-atomic="true">
				<div id="customToastBody" class="toast-body"></div>
			</div>

			<!-- Clipboard -->
			<div id="liveToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
				<div id="toastBody" class="toast-body">
					Copied to clipboard!
				</div>
			</div>
		</div>

		<!-- JQuery JavaScript -->
		<script src="vendor/jquery.min.js"></script>

		<!-- Bootstrap 5 JavaScript -->
		<script src="vendor/bootstrap/bootstrap.bundle.min.js"></script>

		<!-- Custom JavaScript -->
		<script src="vendor/bignumber.min.js"></script>
		<script src="vendor/json-bigint-browser.min.js"></script>
		<script src="./scripts/common/token-thumb-ids.js?v=1"></script>
		<script src="./scripts/common/token-icons.js?v=47"></script>
		<script src="./scripts/main.js?v=76"></script>
		<script src="./scripts/common/token-popup.js?v=42"></script>
		<script src="./scripts/common/mew-ad.js?v=1"></script>

		<script src="./scripts/3rd-party/fleet.js?v=41"></script>
		{% block scripts %}{% endblock %}
	</body>
</html>

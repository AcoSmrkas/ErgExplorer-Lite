`{% extends "layout.njk" %}

{% block styles %}
	<!-- build:css styles/token.css -->
		<link rel="stylesheet" href="styles/token.css">
	<!-- endbuild -->
{% endblock %}

{% block navigation %}
	{% import 'macros/nav-macro.njk' as nav %}
	{{nav.active('')}}
{% endblock %}

{% block content %}
	<div class="row w-100">
		<div class="col-md-12 mb-3 mb-md-4">
			<h2 class="m-0">Token</h2>
		</div>
	</div>

	<div id="tokenDataHolder" style="display: none;" class="col-md-12">
		<div class="row w-100 div-cell-dark token-header-row border-bottom-flat align-items-center">
			<div id="tokenHeader" class="col pe-2 ps-0 ps-md-0"></div>
			<div class="col-auto pe-0">
				<a id="tokenBuyLink" style="display: none;" target="_new" class="btn btn-info token-buy-btn" href="">Buy</a>
			</div>
		</div>

		<div class="row w-100 two-column-holder-top-flat-lg">
			<div id="tokenDataLeft" class="col-lg-4 div-cell-dark border-top-flat p-0">
				<div class="row w-100 p-1">
					<div class="col-5">
						<p><strong class="text-white">Name</strong></p>
					</div>
					<div class="col-7">
						<p id="tokenName"></p>
					</div>
				</div>				
				<div class="row w-100 p-1">
					<div class="col-5">
						<p><strong class="text-white">Emission amount</strong></p>
					</div>
					<div class="col-7">
						<p id="tokenEmissionAmount"></p>
					</div>
				</div>
				<div class="row w-100 p-1">
					<div class="col-5">
						<p><strong class="text-white">Decimals</strong></p>
					</div>
					<div class="col-7">
						<p id="tokenDecimals"></p>
					</div>
				</div>
				<div class="row w-100 p-1">
					<div class="col-5">
						<p><strong class="text-white">Type</strong></p>
					</div>
					<div class="col-7">
						<p id="tokenType"></p>
					</div>
				</div>
				<div style="display: none;" id="tokenBurned" class="row w-100 p-1">
					<div class="col-5">
						<p><strong class="text-white">Status</strong></p>
					</div>
					<div class="col-7">
						<p class="text-danger">Burned</p>
					</div>
				</div>
			</div>

			<div id="tokenDataRight" class="col-lg-8 div-cell-dark border-top-flat p-0">
				<div class="row w-100 p-1">
					<div id="tokenDescriptionHolderLeft" class="col-xl-2 col-lg-3 col-12 col-md-5 mb-2">
						<p><strong class="text-white">Description</strong></p>
					</div>
					<div id="tokenDescriptionHolderRight" class="col-xl-10 col-lg-9 col-12 col-md-7" style="padding-top: 2px;">
						<p id="tokenDescription"></p>
					</div>
					<div id="tokenIcon" style="display: none;" class="p-3 justify-content-center justify-content-lg-end"><img id="tokenIconImg" onload="onTokenIconLoaded()"></div>
				</div>
			</div>
		</div>

		<br>

		<div id="nftHolder" style="display: none;">
			<h3 class="p-2">NFT Info</h3>
			<div class="div-cell-dark row w-100 p-0">
				<div class="col-12 p-0 border-bottom-flat" style="display: none;" id="nftPreviewAudio">
					<audio id="nftAudio" class="border-bottom-flat" controls crossorigin loop name="media"><source id="nftPreviewAudioSource" src="" type="audio/mp3"></audio>
				</div>
				<div id="nftPreviewImgHolder" class="col-lg-3 p-0" style="border-radius: 5px 0 0 5px;">
					<img id="nftPreviewImg" onclick="showFullImgPreview()" style="display: none;" onload="onNftImageLoad()" src="">					
					<video style="display: none;" id="nftPreviewVideo" controls crossorigin allowfullscreen name="media"><source id="nftPreviewVideoSource" src="" type="video/mp4"></video>
				</div>
				<div id="nftInfoHolder" class="col-lg-9 p-0">
					<div class="row w-100 p-2 border-bottom-flat">
						<div class="col-md-3"><strong><p class="text-white">Type</p></strong></div>
						<div id="nftType" class="col"></div>
					</div>
					<div class="row w-100 p-2">
						<div class="col-md-3"><strong><p class="text-white">Mint block</p></strong></div>
						<div id="nftCreationHeight" class="col"></div>
					</div>
					<div class="row w-100 p-2">
						<div class="col-md-3"><strong><p class="text-white">Mint address</p></strong></div>
						<div id="nftMintedAddress" class="col"></div>
					</div>
					<div class="row w-100 p-2">
						<div class="col-md-3"><strong><p class="text-white">Mint transaction</p></strong></div>
						<div id="nftMintedTransaction" class="col"></div>
					</div>		
					<div id="nftCurrentAddressHolder" style="display: none;" class="row w-100 p-2">
						<div class="col-md-3"><strong><p class="text-white">Current address</p></strong></div>
						<div id="nftCurrentAddress" class="col"></div>
					</div>
					<div id="nftBurnTransactionHolder" style="display: none;" class="row w-100 p-2">
						<div class="col-md-3"><strong><p class="text-white">Burn transaction</p></strong></div>
						<div id="nftBurnTransaction" class="col"></div>
					</div>
					<div id="ipfsCidHolder" class="row w-100 p-2">
						<div class="col-md-3"><strong><p class="text-white">IPFS CID</p></strong></div>
						<div id="ipfsCid" class="col"></div>
					</div>
					<div class="row w-100 p-2">
						<div class="col-md-3"><strong><p class="text-white">URL</p></strong></div>
						<div id="nftLink" class="col"></div>
					</div>
					<div id="nftHashHolder" class="row w-100 p-2">
						<div class="col-md-3"><strong><p class="text-white">SHA-256 hash</p></strong></div>
						<div id="nftHash" class="col"></div>
					</div>
					<div id="twitterHolder" style="display: none;" class="row w-100 p-2 border-top-flat">
						<div class="col-md-3"><strong><p class="text-white">Twitter</p></strong></div>
						<div id="nftTwitter" class="col"><a id="twitterLink" href="" target="_new"></a></div>
					</div>
					<div id="instagramHolder" style="display: none;" class="row w-100 p-2 border-top-flat">
						<div class="col-md-3"><strong><p class="text-white">Instagram</p></strong></div>
						<div id="nftInstagram" class="col"><a id="instagramLink" href="" target="_new"></a></div>
					</div>
				</div>
				<div id="nftPropertiesHolder" style="display: none; padding-bottom: 15px;">
					<h3 style="margin-top:25px;margin-bottom: 10px;">Properties</h3>
					<div id="nftProperties" style="display: grid;
	grid-template-columns:  repeat(auto-fill, minmax(150px, 1fr)); /* Creates 3 equal-width columns */
	gap: 10px; /* Space between grid items */"></div>
					</div>
					<div id="nftStatsHolder" style="display: none; padding-bottom: 15px;">
					<h3 style="margin-top:10px;margin-bottom: 10px;">Stats</h3>
					<div id="nftStats" style="display: grid;
	grid-template-columns:  repeat(auto-fill, minmax(150px, 1fr)); /* Creates 3 equal-width columns */
	gap: 10px; /* Space between grid items */"></div>
					</div>
					<div id="nftLevelsHolder" style="display: none; padding-bottom: 15px;">
					<h3 style="margin-top:10px;margin-bottom: 10px;">Levels</h3>
					<div id="nftLevels" style="display: grid;
	grid-template-columns:  repeat(auto-fill, minmax(150px, 1fr)); /* Creates 3 equal-width columns */
	gap: 10px; /* Space between grid items */"></div>
				</div>
			</div>
		</div>

		<div id="tokenHolder" style="display: none;">
			<h3 class="p-2">Info</h3>
			<div class="div-cell-dark row w-100 p-0">
				<div id="nftInfoHolder" class="col-lg-12 p-0">
					<div class="row w-100 p-2 border-bottom-flat">
						<div class="col-md-3"><strong><p class="text-white">Type</p></strong></div>
						<div id="nftType" class="col"></div>
					</div>
					<div class="row w-100 p-2">
						<div class="col-md-3"><strong><p class="text-white">Mint block</p></strong></div>
						<div id="nftCreationHeight" class="col"></div>
					</div>
					<div class="row w-100 p-2">
						<div class="col-md-3"><strong><p class="text-white">Mint address</p></strong></div>
						<div id="nftMintedAddress" class="col"></div>
					</div>
					<div class="row w-100 p-2">
						<div class="col-md-3"><strong><p class="text-white">Mint transaction</p></strong></div>
						<div id="nftMintedTransaction" class="col"></div>
					</div>
					<div id="nftCurrentAddressHolder" style="display: none;" class="row w-100 p-2">
						<div class="col-md-3"><strong><p class="text-white">Current address</p></strong></div>
						<div id="nftCurrentAddress" class="col"></div>
					</div>
				</div>
			</div>
		</div>

		<br>

		<div id="supplyHolder" style="display: none;">
			<h3 class="p-2">Supply</h3>
			<div class="div-cell-dark row w-100 p-0">
				<div id="supplyInfoHolder" class="col-lg-12 p-0 stripedHolder text-white">
					<div id="tokenLiquidSupplyRow" style="display: none;" class="row w-100 p-2">
						<div class="col-md-3"><strong><p class="text-white">Circulating</p></strong></div>
						<div id="tokenLiquidSupply" class="col"></div>
					</div>
					<div id="tokenBurnedSupplyRow" style="display: none;" class="row w-100 p-2">
						<div class="col-md-3"><strong><p class="text-white">Burned</p></strong></div>
						<div id="tokenBurnedSupply" class="col"></div>
					</div>
					<div id="tokenMarketCapRow" style="display: none;" class="row w-100 p-2">
						<div class="col-md-3"><strong><p class="text-white">Market cap</p></strong></div>
						<div id="tokenMarketCap" class="col"></div>
					</div>
				</div>
			</div>
			<br>
		</div>

		<div id="priceInfo" style="display: none;">
			<h3 class="p-2">Market</h3>
			<div class="div-cell-dark row w-100 p-0">
				<div id="marketInfoHolder" class="col-lg-12 p-0 stripedHolder text-white">
					<div class="row w-100 p-2">
						<div class="col-md-3"><strong><p class="text-white">Price</p></strong></div>
						<div id="usdPrice" class="col"></div>
					</div>
					<div class="row w-100 p-2">
						<div class="col-md-3"><strong><p class="text-white">Liquidity</p></strong></div>
						<div id="tokenLiquidity" class="col"></div>
					</div>
					<div class="row w-100 p-2">
						<div class="col-md-3"><strong><p class="text-white">Pools</p></strong></div>
						<div id="tokenPools" class="col"></div>
					</div>
				</div>
			</div>
			<br>
		</div>

		<div id="holdersHolder" style="display: none;">
			<h3 class="p-2"><span id="holdersTitle">Top 10 holders</span> <span id="totalHolderCount" class="text-light"></span></h3>
			<div class="div-cell-dark row w-100 p-0">
				<div class="p-0 col-12">
					<div id="holdersLoading">
						<div id="holdersLoadingInner">
							<img src="./images/logo-300.png" alt="Loading" class="loadingImg index-card-symbol" style="display:block;width:60px;height:60px;margin:20px auto;">
						</div>
					</div>
					<table id="holdersTable" style="display:none;" class="table table-dark table-striped table-mobile m-0">
						<thead>
							<tr>
								<th scope="col">Address</th>
								<th style="min-width:200px;" scope="col">Balance</th>
								<th class="d-none d-lg-table-cell" style="text-align:right;">Share</th>
							</tr>
						</thead>
						<tbody id="holdersTableBody"></tbody>
					</table>
					<p id="holdersNote" style="display: none;" class="text-light p-2 m-0"></p>
				</div>
			</div>
			<br>
		</div>

		<div id="boxesHolder" style="display: none;">
			<h3 class="p-2">Boxes <span id="boxesCount" class="text-light"></span></h3>
			<div class="div-cell-dark row w-100 p-0">
				<div class="p-0 col-12">
					<table id="boxesTable" style="display:none;" class="w-100 table table-dark table-striped table-mobile m-0">
						<thead>
							<tr>
								<th scope="col">Box</th>
								<th class="d-none d-lg-table-cell" scope="col">Block</th>
								<th scope="col">Address</th>
								<th style="min-width:180px" scope="col">Amount</th>
								<th class="d-none d-lg-table-cell" scope="col">Created</th>
								<th scope="col">Spent</th>
							</tr>
						</thead>
						<tbody id="boxesTableBody"></tbody>
					</table>
					<div id="boxesMore" style="display: none;" class="p-2 text-center">
						<input id="boxesMoreBtn" type="button" class="btn btn-info" value="Load more" onclick="loadMoreTokenBoxes()">
					</div>
				</div>
			</div>
		</div>
		<div id="boxesLoading"></div>
	</div>

	{% include "partials/error-message.njk" %}

	{% include "partials/loading.njk" %}

	<br>

	<div id="nftImageFullBack" onclick="hideFullImgPreview()">
		<div id="nftImageFullHolder">	
			<img id="nftImageFull"></div>
		</div>
	</div>
{% endblock %}

{% block scripts %}
	<script src="./scripts/common/prices.js?v=44"></script>
	<script src="./scripts/common/nft.js?v=42"></script>
	<script type="module" src="./scripts/token/index.js?v=58"></script>
{% endblock %}

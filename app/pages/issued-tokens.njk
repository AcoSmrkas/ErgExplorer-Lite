{% extends "layout.njk" %}

{% block styles %}
	<!-- build:css styles/issued-tokens.css -->
	<link rel="stylesheet" href="styles/issued-tokens.css">
	<!-- endbuild -->
{% endblock %}

{% block navigation %}
	{% import 'macros/nav-macro.njk' as nav %}
	{{nav.active('issued-tokens')}}
{% endblock %}

{% block content %}
	<div class="col-md-12">
		<div class="row w-100 align-items-center">
			<div class="col-12 col-lg-6">
				<h2>Recently minted tokens</h2>
			</div>
			<div class="col-12 col-lg-6">
				<div id="tokenIdLookup" class="d-flex">
					<input id="tokenIdInput" type="text" class="form-control form-control-lg" placeholder="Token ID" autocomplete="off" spellcheck="false">
					<input type="button" class="btn btn-info ms-2" value="Open" onclick="openTokenId()">
				</div>
				<p id="tokenIdError" style="display: none;" class="text-danger m-0 mt-1"></p>
			</div>
		</div>

		<br>

		<div id="issuedTokensHolder" style="display: none;">
			<p id="issuedTokensEmpty" style="display: none;" class="text-light">No tokens were minted in these blocks.</p>

			<div class="row w-100">
				<table id="issuedTokensTable" style="display: none;" class="table table-dark table-striped table-mobile">
					<thead>
						<tr>
							<th scope="col">Id</th>
							<th style="min-width:200px" scope="col">Name</th>
							<th style="min-width:75px" scope="col">Type</th>
							<th scope="col">Amount</th>
							<th scope="col">Description</th>
							<th style="min-width:140px" scope="col">Minted</th>
						</tr>
					</thead>

					<tbody id="issuedTokensTableBody">
					</tbody>
				</table>
			</div>

			<div class="text-center">
				<p id="issuedTokensRange" class="text-light"></p>
				<div id="issuedTokensLoading" style="display: none;">
					<img src="./images/logo-300.png" alt="Loading" class="loadingImg index-card-symbol" style="display:block;width:60px;height:60px;margin:20px auto;">
				</div>
				<input id="loadMoreTokens" type="button" class="btn btn-info" value="Load more" onclick="loadMoreTokens()">
			</div>
		</div>
	</div>

	{% include "partials/error-message.njk" %}

	{% include "partials/loading.njk" %}
{% endblock %}

{% block scripts %}
	<script src="./scripts/common/nft.js?v=43"></script>
	<script src="./scripts/issued-tokens.js?v=44"></script>
{% endblock %}
